# Web app (Vite bakes these in at build time). AI Studio injects GEMINI_API_KEY itself;
# locally, copy this file to .env.local and fill it in.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Where the app is hosted (AI Studio injects the Cloud Run URL).
APP_URL="MY_APP_URL"

# server.js has three OPTIONAL runtime variables — see README "server.js variables". Leave them unset
# on Cloud Run / AI Studio: FIRESTORE_DATABASE_ID, VIALTRACK_API_KEY, GOOGLE_APPLICATION_CREDENTIALS.
