rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        ((request.auth.token.email in ["duval.villegas@mdexam.com", "duval.villegas@gmail.com"] && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isStaffOrAdmin() {
      return isAuthenticated() &&
        ((request.auth.token.email in ["duval.villegas@mdexam.com", "duval.villegas@gmail.com"] && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff']));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser() {
      return hasRequiredFields(['email', 'role']) &&
             request.resource.data.email is string &&
             request.resource.data.role in ['admin', 'staff'];
    }

    function isValidLocation() {
      return hasRequiredFields(['name', 'type', 'qrCode', 'createdAt']) &&
             request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100 &&
             request.resource.data.type in ['fridge', 'shelf', 'cabinet'] &&
             request.resource.data.qrCode is string && request.resource.data.qrCode.size() < 100 &&
             request.resource.data.createdAt is string;
    }

    function isValidProduct() {
      return hasRequiredFields(['name', 'category', 'currentStock', 'createdAt']) &&
             request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200 &&
             request.resource.data.category is string && request.resource.data.category.size() < 100 &&
             request.resource.data.currentStock is number && request.resource.data.currentStock >= 0 &&
             request.resource.data.createdAt is string;
    }

    function isValidBasket() {
      return hasRequiredFields(['productId', 'locationId', 'name', 'trayCount', 'vialsPerTray', 'looseVials', 'qrCode', 'createdAt']) &&
             request.resource.data.productId is string &&
             request.resource.data.locationId is string &&
             request.resource.data.name is string &&
             request.resource.data.trayCount is number && request.resource.data.trayCount >= 0 &&
             request.resource.data.vialsPerTray is number && request.resource.data.vialsPerTray > 0 &&
             request.resource.data.looseVials is number && request.resource.data.looseVials >= 0 &&
             request.resource.data.qrCode is string && request.resource.data.qrCode.size() < 100 &&
             request.resource.data.createdAt is string &&
             (!request.resource.data.keys().hasAny(['shelfId']) || request.resource.data.shelfId is string) &&
             (!request.resource.data.keys().hasAny(['shelfPosition']) || request.resource.data.shelfPosition is number) &&
             (!request.resource.data.keys().hasAny(['lastCountedAt']) || request.resource.data.lastCountedAt is string) &&
             (!request.resource.data.keys().hasAny(['lastCountedBy']) || request.resource.data.lastCountedBy is string) &&
             (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is string);
    }

    function isValidInventoryLog() {
      return hasRequiredFields(['productId', 'userId', 'action', 'amount', 'timestamp']) &&
             request.resource.data.productId is string &&
             request.resource.data.userId is string &&
             request.resource.data.action in ['ADD', 'REMOVE', 'ADJUST', 'COUNT'] &&
             request.resource.data.amount is number &&
             request.resource.data.timestamp is string;
    }

    function isValidPrintJob() {
      return hasRequiredFields(['code', 'title', 'format', 'status', 'createdAt']) &&
             request.resource.data.code is string &&
             request.resource.data.title is string &&
             request.resource.data.format in ['4x3', '1.5x1.5', '2.5x0.7', '2.5x1.5', 'canon-integrated'] &&
             request.resource.data.status in ['pending', 'completed'] &&
             request.resource.data.createdAt is string;
    }

    function isValidConfig() {
      return hasRequiredFields(['fridges']) &&
             request.resource.data.fridges is list &&
             (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is string) &&
             (!request.resource.data.keys().hasAny(['updatedBy']) || request.resource.data.updatedBy is string);
    }

    function isValidCountingSession() {
      return hasRequiredFields(['userId', 'status', 'startedAt']) &&
             request.resource.data.userId is string &&
             request.resource.data.status in ['active', 'in_progress', 'paused', 'completed', 'abandoned'] &&
             request.resource.data.startedAt is string &&
             (!request.resource.data.keys().hasAny(['userName']) || request.resource.data.userName is string) &&
             (!request.resource.data.keys().hasAny(['locationId']) || request.resource.data.locationId is string) &&
             (!request.resource.data.keys().hasAny(['fridgeId']) || request.resource.data.fridgeId is string) &&
             (!request.resource.data.keys().hasAny(['activeBasketId']) || request.resource.data.activeBasketId is string || request.resource.data.activeBasketId == null) &&
             (!request.resource.data.keys().hasAny(['completedAt']) || request.resource.data.completedAt is string) &&
             (!request.resource.data.keys().hasAny(['progress']) || request.resource.data.progress is map) &&
             (!request.resource.data.keys().hasAny(['countedBaskets']) || request.resource.data.countedBaskets is list);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUser() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && isValidUser() && (isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    match /whitelist/{email} {
      allow read: if isAuthenticated() && (request.auth.token.email == email || request.auth.token.email.lower() == email || isAdmin());
      allow write: if isAdmin();
    }

    // Domain-level whitelist: any signed-in user whose email ends in @{domain}
    // is granted the configured role. Doc IDs are the lowercase domain
    // (e.g. "mdexam.com"). Reads are open to authenticated users so that
    // sign-in can self-check; writes are admin-only.
    match /whitelistDomains/{domain} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow create: if isStaffOrAdmin() && isValidLocation();
      allow update: if isStaffOrAdmin() && isValidLocation();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isStaffOrAdmin() && isValidProduct();
      allow update: if isStaffOrAdmin() && isValidProduct();
      allow delete: if isAdmin();
    }

    match /baskets/{basketId} {
      allow read: if isAuthenticated();
      allow create: if isStaffOrAdmin() && isValidBasket();
      allow update: if isStaffOrAdmin() && isValidBasket();
      allow delete: if isAdmin();
    }

    match /inventoryLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isStaffOrAdmin() && isValidInventoryLog() && request.resource.data.userId == request.auth.uid;
      allow update: if false; // Logs are immutable
      allow delete: if isAdmin(); // Allow admins to delete for factory reset
    }

    match /printJobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPrintJob();
      allow update: if isAuthenticated() && isValidPrintJob();
      allow delete: if isAdmin();
    }

    // App-wide configuration (e.g. fridges/shelves layout). Only admins write.
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidConfig();
    }

    // Shelves live as a subcollection beneath each fridge/location.
    match /locations/{locationId}/shelves/{shelfId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // Trays live as a subcollection beneath each basket.
    match /baskets/{basketId}/trays/{trayId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // Counting sessions track an in-progress inventory count.
    match /countingSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaffOrAdmin() && isValidCountingSession();
      allow delete: if isAdmin();
    }

    // Learning data captures samples that train the vial-detection model.
    match /learningData/{entryId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }
  }
}
