# ---- Web app (Vite, baked in at build time) ----------------------------------
# GEMINI_API_KEY: required for the AI vial count and label reading.
# AI Studio injects it automatically; locally put it in .env.local (git-ignored).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: where the app is hosted (AI Studio injects the Cloud Run URL).
APP_URL="MY_APP_URL"

# ---- server.js (Node, read at runtime) ---------------------------------------
# Optional: overrides the API key stored under Settings → API Bridge for /api/v1 and the sale webhook.
# VIALTRACK_API_KEY="long-random-string"

# Optional: Firestore database ID. Defaults to firestoreDatabaseId in firebase-applet-config.json.
# FIRESTORE_DATABASE_ID="ai-studio-198437a8-7e10-4c8b-9a00-22acac4c2d1f"

# Local only: service account key for firebase-admin (Cloud Run provides credentials automatically).
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
